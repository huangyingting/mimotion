# Copy to .env for local use. Never commit real credentials.
# Use Zepp Life credentials, not a Xiaomi account.
# Separate multiple accounts and matching passwords with #.
USER=your_email@example.com
PWD=your_password

# Fixed minimum plus a time-scaled random bonus over a Beijing day.
MIN_STEP=15000
MAX_STEP=18000

# Optional: random 16-character ASCII key to save encrypted login tokens.
AES_KEY=

# Optional multi-account settings. Concurrent mode ignores SLEEP_GAP.
SLEEP_GAP=5
USE_CONCURRENT=False

# Optional PushPlus notifications.
PUSH_PLUS_TOKEN=
PUSH_PLUS_HOUR=
PUSH_PLUS_MAX=30

# Optional WeCom webhook key.
PUSH_WECHAT_WEBHOOK_KEY=

# Optional Telegram notifications; both fields are required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional JSON configuration; overrides the individual settings above.
# CONFIG='{"USER":"your_email@example.com","PWD":"your_password","MIN_STEP":"15000","MAX_STEP":"18000"}'
